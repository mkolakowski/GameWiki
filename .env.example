# GameWiki environment.
# docker-compose sets all of these automatically for the app service — you only
# need them when running outside Docker or deploying.

# DATABASE_URL=postgresql://gamewiki:gamewiki@db:5432/gamewiki

# Base URL the integration suite points at.
# GAMEWIKI_BASE_URL=http://localhost:8000

# --- Google sign-in -------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in the Google Cloud
# console, and add <your-origin>/auth/callback as an authorised redirect URI.
#
# Leave OIDC_DISCOVERY_URL unset in production: it defaults to Google. Compose
# overrides it to the local stub provider so dev and CI work offline.
# OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=<client id>.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=<client secret>

# Signs the session cookie. Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# If unset, an ephemeral secret is generated at boot and every restart signs
# everyone out. Set it in production.
# SESSION_SECRET=<random string>

# --- who may edit ---------------------------------------------------------
# Comma-separated. An account matching either list gets the editor role at
# sign-in; everyone else signs in as a reader and gets a 403 on any write.
# Leave BOTH unset and the wiki is open to any account that can sign in —
# /health reports allowlist_configured so that isn't a silent default.
#
# The role is recomputed on every sign-in, so removing someone here revokes
# their access. Admins are exempt, and the first account on a fresh instance
# becomes admin. Changing a role afterwards means an UPDATE on users.role.
# ALLOWED_EMAILS=you@example.com,someone@example.com
# ALLOWED_DOMAINS=example.com

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# SESSION_HTTPS_ONLY=1

# Where the tests reach the stub OIDC provider. Compose sets this.
# OIDC_TEST_BASE_URL=http://oidc:9000
#
# To click through sign-in in a real browser against the stub, add this line
# to /etc/hosts so the host resolves the same name Docker does:
#     127.0.0.1 oidc
